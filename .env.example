# Server-only — used by lib/supabase/server-client.ts. The service_role key
# bypasses Row Level Security, which is required for this dashboard to read
# across all users' data (not just a signed-in individual's own rows). Never
# prefix these with NEXT_PUBLIC_ or use them in client components.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
